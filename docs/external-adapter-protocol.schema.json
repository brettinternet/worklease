{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brettinternet/worklease/blob/main/docs/external-adapter-protocol.schema.json",
  "title": "Worklease external source adapter protocol v1 messages",
  "description": "Each LF-delimited JSON-RPC object validates against exactly one envelope. Method-specific parameter and result schemas are in $defs; response IDs are correlated with outstanding requests by the host.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/failure" },
    { "$ref": "#/$defs/cancel" }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "text": { "type": "string", "maxLength": 4096 },
    "ref": { "type": "object", "required": ["sourceId", "itemId"], "properties": { "sourceId": { "$ref": "#/$defs/id" }, "itemId": { "$ref": "#/$defs/text", "minLength": 1 } }, "additionalProperties": false },
    "budget": { "type": "object", "required": ["maxItems", "maxBytes"], "properties": { "maxItems": { "type": "integer", "minimum": 1, "maximum": 100 }, "maxBytes": { "type": "integer", "minimum": 1, "maximum": 786432 } }, "additionalProperties": false },
    "base": { "type": "object", "required": ["deadline", "budget"], "properties": { "deadline": { "type": "string", "format": "date-time" }, "budget": { "$ref": "#/$defs/budget" }, "sourceId": { "$ref": "#/$defs/id" } }, "additionalProperties": true },
    "context": { "type": "object", "required": ["principal", "configurationGeneration", "observedAt", "coverage", "providerVersion"], "properties": { "principal": { "type": ["string", "null"] }, "configurationGeneration": { "$ref": "#/$defs/text" }, "observedAt": { "type": "string", "format": "date-time" }, "coverage": { "$ref": "#/$defs/coverage" }, "providerVersion": { "type": ["string", "null"] } }, "additionalProperties": true },
    "coverage": { "type": "object", "required": ["state", "scope"], "properties": { "state": { "enum": ["complete", "partial", "unknown"] }, "scope": { "$ref": "#/$defs/text" }, "cursor": { "type": ["string", "null"], "maxLength": 4096 } }, "additionalProperties": true },
    "capability": { "type": "object", "required": ["support", "permission", "availability"], "properties": { "support": { "enum": ["supported", "unsupported", "unknown"] }, "permission": { "enum": ["allowed", "denied", "unknown"] }, "availability": { "enum": ["available", "unavailable", "authentication-required"] }, "semantics": { "type": "object", "additionalProperties": { "$ref": "#/$defs/text" } }, "limits": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }, "reason": { "$ref": "#/$defs/text" } }, "additionalProperties": true },
    "manifest": { "type": "object", "required": ["id", "version", "protocol", "configSchema", "authentication", "resourcePolicy", "capabilities", "requiredFeatures"], "properties": { "id": { "$ref": "#/$defs/id" }, "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" }, "protocol": { "type": "object", "required": ["minMajor", "maxMajor"], "properties": { "minMajor": { "type": "integer", "minimum": 1 }, "maxMajor": { "type": "integer", "minimum": 1 } }, "additionalProperties": false }, "configSchema": { "type": "object" }, "authentication": { "type": "array", "items": { "type": "string" }, "maxItems": 100 }, "resourcePolicy": { "enum": ["backlog-md", "markdown", "github", "linear", "generic", "path"] }, "capabilities": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true, "maxItems": 100 }, "requiredFeatures": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true, "maxItems": 100 } }, "additionalProperties": true },
    "receipt": { "type": "object", "required": ["sourceId", "ref", "operation", "providerVersion", "durableLocation", "observedState", "conditionalWrite", "fencingEvidence"], "properties": { "sourceId": { "$ref": "#/$defs/id" }, "ref": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "null" }] }, "operation": { "enum": ["writeState", "recordProgress", "assign", "archive"] }, "providerVersion": { "type": ["string", "null"] }, "durableLocation": { "$ref": "#/$defs/text" }, "observedState": { "type": "object" }, "conditionalWrite": { "type": "boolean" }, "fencingEvidence": { "type": ["object", "null"] } }, "additionalProperties": true },
    "authority": { "type": "object", "required": ["authorizationRef", "scope"], "properties": { "authorizationRef": { "$ref": "#/$defs/id" }, "scope": { "$ref": "#/$defs/text" } }, "additionalProperties": false },
    "edge": { "type": "object", "required": ["from", "to", "relationshipType", "direction", "completionCondition", "rawOutcome", "interpretation"], "properties": { "from": { "$ref": "#/$defs/ref" }, "to": { "$ref": "#/$defs/ref" }, "relationshipType": { "type": "string" }, "direction": { "enum": ["prerequisite", "dependent", "non-blocking", "unknown"] }, "completionCondition": { "type": ["string", "null"] }, "rawOutcome": {}, "interpretation": { "type": "object" } }, "additionalProperties": true },
    "outcome": { "type": "object", "required": ["ref", "status"], "properties": { "ref": { "$ref": "#/$defs/ref" }, "status": { "enum": ["found", "missing", "inaccessible", "failed"] }, "item": { "type": "object", "required": ["ref"], "properties": { "ref": { "$ref": "#/$defs/ref" } } }, "diagnostic": { "$ref": "#/$defs/text" } }, "allOf": [{ "if": { "properties": { "status": { "const": "found" } } }, "then": { "required": ["item"] }, "else": { "not": { "required": ["item"] } } }], "additionalProperties": true },
    "initParams": { "type": "object", "required": ["protocolMajors", "hostFeatures"], "properties": { "protocolMajors": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1, "maxItems": 16, "uniqueItems": true }, "hostFeatures": { "type": "array", "items": { "$ref": "#/$defs/id" }, "maxItems": 100, "uniqueItems": true } }, "additionalProperties": false },
    "resolveParams": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["sourceId", "config"], "properties": { "config": { "type": "object" }, "credentialRef": { "$ref": "#/$defs/id" } } }] },
    "credentialParams": { "type": "object", "required": ["sourceId", "origin", "credential", "deadline", "budget"], "properties": { "sourceId": { "$ref": "#/$defs/id" }, "origin": { "type": "string", "format": "uri", "pattern": "^https://" }, "credential": { "type": "string", "minLength": 1, "maxLength": 4096 }, "deadline": { "type": "string", "format": "date-time" }, "budget": { "$ref": "#/$defs/budget" } }, "additionalProperties": false },
    "credentialResult": { "type": "object", "required": ["sourceId", "origin", "principal"], "properties": { "sourceId": { "$ref": "#/$defs/id" }, "origin": { "type": "string", "format": "uri", "pattern": "^https://" }, "principal": { "$ref": "#/$defs/text", "minLength": 1 }, "expiresAt": { "type": "string", "format": "date-time" } }, "additionalProperties": false },
    "capabilitiesParams": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["sourceId", "principal"], "properties": { "principal": { "type": ["string", "null"] }, "ref": { "$ref": "#/$defs/ref" }, "action": { "$ref": "#/$defs/text" } } }] },
    "listParams": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["sourceId", "query", "cursor", "fields"], "properties": { "query": { "type": "object" }, "cursor": { "type": ["string", "null"], "maxLength": 4096 }, "fields": { "type": "array", "items": { "$ref": "#/$defs/text" }, "maxItems": 100 } } }] },
    "readItemsParams": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["sourceId", "refs", "fields"], "properties": { "refs": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "minItems": 1, "maxItems": 100 }, "fields": { "type": "array", "items": { "$ref": "#/$defs/text" }, "maxItems": 100 } } }] },
    "dependenciesParams": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["ref", "cursor"], "properties": { "ref": { "$ref": "#/$defs/ref" }, "cursor": { "type": ["string", "null"], "maxLength": 4096 } } }] },
    "changesParams": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["sourceId", "cursor"], "properties": { "cursor": { "type": ["string", "null"], "maxLength": 4096 } } }] },
    "readItemParams": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["ref"], "properties": { "ref": { "$ref": "#/$defs/ref" } } }] },
    "policyParams": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["ref", "workKey"], "properties": { "ref": { "$ref": "#/$defs/ref" }, "workKey": { "$ref": "#/$defs/id" } } }] },
    "mutationParams": { "type": "object", "required": ["deadline", "budget", "ref", "operationId", "patch", "authority"], "properties": { "deadline": { "type": "string", "format": "date-time" }, "budget": { "$ref": "#/$defs/budget" }, "ref": { "$ref": "#/$defs/ref" }, "operationId": { "$ref": "#/$defs/id" }, "patch": { "type": "object" }, "expectedVersion": { "type": ["string", "null"] }, "authority": { "$ref": "#/$defs/authority" } }, "additionalProperties": false },
    "receiptParams": { "type": "object", "required": ["deadline", "budget", "sourceId", "operationId", "operation", "target", "intent", "receipt"], "properties": { "deadline": { "type": "string", "format": "date-time" }, "budget": { "$ref": "#/$defs/budget" }, "sourceId": { "$ref": "#/$defs/id" }, "operationId": { "$ref": "#/$defs/id" }, "operation": { "enum": ["writeState", "recordProgress", "assign", "archive"] }, "target": { "oneOf": [{ "$ref": "#/$defs/ref" }, { "type": "object", "required": ["sourceId"], "properties": { "sourceId": { "$ref": "#/$defs/id" } }, "additionalProperties": false }] }, "intent": { "type": "object", "required": ["payload", "expectedVersion"], "properties": { "payload": { "type": "object" }, "expectedVersion": { "type": ["string", "null"] } }, "additionalProperties": false }, "receipt": { "oneOf": [{ "$ref": "#/$defs/receipt" }, { "type": "null" }] } }, "additionalProperties": false },
    "reviewParams": { "allOf": [{ "$ref": "#/$defs/base" }, { "type": "object", "required": ["sourceId", "selector", "authority"], "properties": { "selector": { "type": "object" }, "authority": { "$ref": "#/$defs/authority" } } }] },
    "archiveParams": { "type": "object", "required": ["deadline", "budget", "sourceId", "target", "operationId", "authority"], "properties": { "deadline": { "type": "string", "format": "date-time" }, "budget": { "$ref": "#/$defs/budget" }, "sourceId": { "$ref": "#/$defs/id" }, "target": { "type": "object" }, "operationId": { "$ref": "#/$defs/id" }, "expectedVersion": { "type": ["string", "null"] }, "authority": { "$ref": "#/$defs/authority" } }, "additionalProperties": false },
    "request": { "type": "object", "required": ["jsonrpc", "id", "method", "params"], "properties": { "jsonrpc": { "const": "2.0" }, "id": { "$ref": "#/$defs/id" }, "method": { "enum": ["initialize", "resolve", "credential", "capabilities", "list", "readItems", "readDependencies", "changes", "readItem", "resourcePolicy", "writeState", "recordProgress", "assign", "readReceipt", "resolveReviewBoundary", "archive"] }, "params": { "type": "object" } }, "allOf": [
      { "if": { "properties": { "method": { "const": "initialize" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/initParams" } } } },
      { "if": { "properties": { "method": { "const": "resolve" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/resolveParams" } } } },
      { "if": { "properties": { "method": { "const": "credential" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/credentialParams" } } } },
      { "if": { "properties": { "method": { "const": "capabilities" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/capabilitiesParams" } } } },
      { "if": { "properties": { "method": { "const": "list" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/listParams" } } } },
      { "if": { "properties": { "method": { "const": "readItems" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/readItemsParams" } } } },
      { "if": { "properties": { "method": { "const": "readDependencies" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/dependenciesParams" } } } },
      { "if": { "properties": { "method": { "const": "changes" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/changesParams" } } } },
      { "if": { "properties": { "method": { "const": "readItem" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/readItemParams" } } } },
      { "if": { "properties": { "method": { "const": "resourcePolicy" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/policyParams" } } } },
      { "if": { "properties": { "method": { "enum": ["writeState", "recordProgress", "assign"] } } }, "then": { "properties": { "params": { "$ref": "#/$defs/mutationParams" } } } },
      { "if": { "properties": { "method": { "const": "readReceipt" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/receiptParams" } } } },
      { "if": { "properties": { "method": { "const": "resolveReviewBoundary" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/reviewParams" } } } },
      { "if": { "properties": { "method": { "const": "archive" } } }, "then": { "properties": { "params": { "$ref": "#/$defs/archiveParams" } } } }
    ], "additionalProperties": false },
    "initializeResult": { "type": "object", "required": ["protocolVersion", "manifest"], "properties": { "protocolVersion": { "type": "integer", "minimum": 1 }, "manifest": { "$ref": "#/$defs/manifest" } }, "additionalProperties": true },
    "resolveResult": { "type": "object", "required": ["context", "source"], "properties": { "context": { "$ref": "#/$defs/context" }, "source": { "type": "object", "required": ["id", "name", "locator"], "properties": { "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/text" }, "locator": { "$ref": "#/$defs/text" } }, "additionalProperties": true } }, "additionalProperties": true },
    "capabilitiesResult": { "type": "object", "required": ["context", "capabilities"], "properties": { "context": { "$ref": "#/$defs/context" }, "capabilities": { "type": "object", "additionalProperties": { "$ref": "#/$defs/capability" } } }, "additionalProperties": true },
    "listResult": { "type": "object", "required": ["context", "items", "nextCursor", "total"], "properties": { "context": { "$ref": "#/$defs/context" }, "items": { "type": "array", "items": { "type": "object", "required": ["ref"], "properties": { "ref": { "$ref": "#/$defs/ref" } }, "additionalProperties": true }, "maxItems": 100 }, "nextCursor": { "type": ["string", "null"], "maxLength": 4096 }, "total": { "type": "object", "required": ["value", "accuracy"], "properties": { "value": { "type": ["integer", "null"], "minimum": 0 }, "accuracy": { "enum": ["exact", "estimated", "unknown"] } }, "additionalProperties": false } }, "additionalProperties": true },
    "itemsResult": { "type": "object", "required": ["context", "outcomes"], "properties": { "context": { "$ref": "#/$defs/context" }, "outcomes": { "type": "array", "items": { "$ref": "#/$defs/outcome" }, "maxItems": 100 } }, "additionalProperties": true },
    "dependenciesResult": { "type": "object", "required": ["context", "edges", "nextCursor", "completeness"], "properties": { "context": { "$ref": "#/$defs/context" }, "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" }, "maxItems": 100 }, "nextCursor": { "type": ["string", "null"], "maxLength": 4096 }, "completeness": { "enum": ["complete", "partial", "unknown"] } }, "additionalProperties": true },
    "changesResult": { "type": "object", "required": ["context", "changes", "nextCursor"], "properties": { "context": { "$ref": "#/$defs/context" }, "changes": { "type": "array", "items": { "type": "object" }, "maxItems": 100 }, "nextCursor": { "type": ["string", "null"], "maxLength": 4096 } }, "additionalProperties": true },
    "itemResult": { "type": "object", "required": ["context", "outcome"], "properties": { "context": { "$ref": "#/$defs/context" }, "outcome": { "$ref": "#/$defs/outcome" } }, "additionalProperties": true },
    "policyResult": { "type": "object", "required": ["context", "policy", "source", "item", "scope"], "properties": { "context": { "$ref": "#/$defs/context" }, "policy": { "enum": ["backlog-md", "markdown", "github", "linear", "generic", "path"] }, "source": { "$ref": "#/$defs/text" }, "item": { "$ref": "#/$defs/text" }, "scope": { "$ref": "#/$defs/text" } }, "additionalProperties": true },
    "mutationResult": { "type": "object", "required": ["context", "receipt"], "properties": { "context": { "$ref": "#/$defs/context" }, "receipt": { "$ref": "#/$defs/receipt" } }, "additionalProperties": true },
    "receiptResult": { "type": "object", "required": ["context", "verification", "evidence"], "properties": { "context": { "$ref": "#/$defs/context" }, "verification": { "enum": ["verified", "conflict", "unknown"] }, "evidence": { "type": "object", "properties": { "sourceId": { "$ref": "#/$defs/id" }, "itemId": { "$ref": "#/$defs/text", "minLength": 1 }, "precondition": { "type": ["string", "null"], "maxLength": 4096 }, "patch": { "type": "object", "additionalProperties": { "$ref": "#/$defs/text" } }, "markerCount": { "type": "integer", "minimum": 0 }, "appendContent": { "$ref": "#/$defs/text" }, "appendProof": { "type": "boolean" } }, "additionalProperties": true } }, "allOf": [{ "if": { "properties": { "verification": { "const": "verified" } }, "required": ["verification"] }, "then": { "properties": { "evidence": { "required": ["sourceId", "itemId", "precondition", "patch", "markerCount", "appendContent", "appendProof"] } } } }], "additionalProperties": true },
    "reviewResult": { "type": "object", "required": ["context", "boundary"], "properties": { "context": { "$ref": "#/$defs/context" }, "boundary": { "type": "object", "required": ["itemRefs"], "properties": { "itemRefs": { "type": "array", "items": { "$ref": "#/$defs/ref" }, "maxItems": 100 } }, "additionalProperties": true } }, "additionalProperties": true },
    "success": { "type": "object", "required": ["jsonrpc", "id", "result"], "properties": { "jsonrpc": { "const": "2.0" }, "id": { "$ref": "#/$defs/id" }, "result": { "anyOf": [{ "$ref": "#/$defs/initializeResult" }, { "$ref": "#/$defs/resolveResult" }, { "$ref": "#/$defs/credentialResult" }, { "$ref": "#/$defs/capabilitiesResult" }, { "$ref": "#/$defs/listResult" }, { "$ref": "#/$defs/itemsResult" }, { "$ref": "#/$defs/dependenciesResult" }, { "$ref": "#/$defs/changesResult" }, { "$ref": "#/$defs/itemResult" }, { "$ref": "#/$defs/policyResult" }, { "$ref": "#/$defs/mutationResult" }, { "$ref": "#/$defs/receiptResult" }, { "$ref": "#/$defs/reviewResult" }] } }, "additionalProperties": false },
    "failure": { "type": "object", "required": ["jsonrpc", "id", "error"], "properties": { "jsonrpc": { "const": "2.0" }, "id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }, "error": { "type": "object", "required": ["code", "message", "data"], "properties": { "code": { "type": "integer", "enum": [-32700, -32600, -32601, -32602, -32603, -32001, -32002, -32003, -32004, -32005, -32006, -32007, -32008, -32009, -32010] }, "message": { "$ref": "#/$defs/text" }, "data": { "type": "object", "required": ["diagnostic"], "properties": { "diagnostic": { "enum": ["parse-error", "invalid-request", "method-not-found", "invalid-params", "internal-error", "unsupported-capability", "authentication-required", "authentication-failed", "authorization-denied", "conflict", "rate-limited", "unavailable-source", "incomplete-graph", "unknown-outcome", "credential-scope-mismatch"] }, "retryAt": { "type": "string", "format": "date-time" }, "providerCode": { "$ref": "#/$defs/text" } }, "additionalProperties": false } }, "allOf": [
      { "if": { "properties": { "code": { "const": -32700 } } }, "then": { "properties": { "data": { "properties": { "diagnostic": { "const": "parse-error" } } } } } },
      { "if": { "properties": { "code": { "const": -32600 } } }, "then": { "properties": { "data": { "properties": { "diagnostic": { "const": "invalid-request" } } } } } },
      { "if": { "properties": { "code": { "const": -32601 } } }, "then": { "properties": { "data": { "properties": { "diagnostic": { "const": "method-not-found" } } } } } },
      { "if": { "properties": { "code": { "const": -32602 } } }, "then": { "properties": { "data": { "properties": { "diagnostic": { "const": "invalid-params" } } } } } },
      { "if": { "properties": { "code": { "const": -32603 } } }, "then": { "properties": { "data": { "properties": { "diagnostic": { "const": "internal-error" } } } } } },
      { "if": { "properties": { "code": { "const": -32001 } } }, "then": { "properties": { "data": { "properties": { "diagnostic": { "const": "unsupported-capability" } } } } } },
      { "if": { "properties": { "code": { "const": -32002 } } }, "then": { "properties": { "data": { "properties": { "diagnostic": { "const": "authentication-required" } } } } } },
      { "if": { "properties": { "code": { "const": -32003 } } }, "then": { "properties": { "data": { "properties": { "diagnostic": { "const": "authentication-failed" } } } } } },
      { "if": { "properties": { "code": { "const": -32004 } } }, "then": { "properties": { "data": { "properties": { "diagnostic": { "const": "authorization-denied" } } } } } },
      { "if": { "properties": { "code": { "const": -32005 } } }, "then": { "properties": { "data": { "properties": { "diagnostic": { "const": "conflict" } } } } } },
      { "if": { "properties": { "code": { "const": -32006 } } }, "then": { "properties": { "data": { "properties": { "diagnostic": { "const": "rate-limited" } } } } } },
      { "if": { "properties": { "code": { "const": -32007 } } }, "then": { "properties": { "data": { "properties": { "diagnostic": { "const": "unavailable-source" } } } } } },
      { "if": { "properties": { "code": { "const": -32008 } } }, "then": { "properties": { "data": { "properties": { "diagnostic": { "const": "incomplete-graph" } } } } } },
      { "if": { "properties": { "code": { "const": -32009 } } }, "then": { "properties": { "data": { "properties": { "diagnostic": { "const": "unknown-outcome" } } } } } },
      { "if": { "properties": { "code": { "const": -32010 } } }, "then": { "properties": { "data": { "properties": { "diagnostic": { "const": "credential-scope-mismatch" } } } } } }
    ], "additionalProperties": false } }, "additionalProperties": false },
    "cancel": { "type": "object", "required": ["jsonrpc", "method", "params"], "properties": { "jsonrpc": { "const": "2.0" }, "method": { "const": "$/cancelRequest" }, "params": { "type": "object", "required": ["id"], "properties": { "id": { "$ref": "#/$defs/id" } }, "additionalProperties": false } }, "additionalProperties": false }
  }
}
